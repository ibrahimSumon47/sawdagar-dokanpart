{
  "name": "sawdagar-dokanpat",
  "version": "0.1.0",
  "private": true,
  "description": "A non-commercial Bangladeshi marketplace demonstration.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "pnpm format:check && turbo run lint",
    "format": "prettier --write \"apps/web/{app,features,i18n,lib}/**/*.{ts,tsx,css}\" \"apps/web/*.{ts,mjs}\" \"packages/*/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"apps/web/{app,features,i18n,lib}/**/*.{ts,tsx,css}\" \"apps/web/*.{ts,mjs}\" \"packages/*/src/**/*.{ts,tsx,css}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
