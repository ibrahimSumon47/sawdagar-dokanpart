// Authentication, profiles and audit tables for Phase 2.
//
// The authentication models follow the Better Auth schema for its admin and
// organization plugins. Extra columns (isDemo, role defaults) are declared so
// the demo accounts can be recognised without a second lookup.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("buyer")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  isDemo        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]   @relation("InvitationInviter")
  profile       Profile?
  auditLogs     AuditLog[]     @relation("AuditActor")
  cart          Cart?
  wishlistItems WishlistItem[]
  addresses     Address[]
  orders        Order[]
  couponRedemptions CouponRedemption[]
  mailOutbox    MailOutbox[]
  reviews       Review[]
  questions     ProductQuestion[]
  returnRequests ReturnRequest[]

  @@map("users")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  impersonatedBy       String?
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id            String       @id
  name          String
  slug          String       @unique
  logo          String?
  district      String?
  descriptionEn String?
  descriptionBn String?
  verified      Boolean      @default(false)
  // Seller Center onboarding and storefront CMS fields.
  status          String   @default("pending")
  kycStatus       String   @default("not_started")
  kycSubmittedAt  DateTime?
  kycReviewedAt   DateTime?
  kycNote         String?
  legalName       String?
  businessType    String?
  tradeLicense    String?
  payoutPhone     String?
  accent          String   @default("accent")
  coverTone       String   @default("highlight")
  announcementEn  String?
  announcementBn  String?
  aboutEn         String?
  aboutBn         String?
  returnPolicyEn  String?
  returnPolicyBn  String?
  shippingPolicyEn String?
  shippingPolicyBn String?
  commissionRateBps Int      @default(800)
  rating        Float        @default(0)
  reviewCount   Int          @default(0)
  followers     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  metadata      String?
  members       Member[]
  invitations   Invitation[]
  products      Product[]
  coupons       Coupon[]
  subOrders     SubOrder[]
  payouts       Payout[]
  refunds       Refund[]

  @@map("organizations")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int    @default(0)
  lastRequest BigInt @default(0)

  @@map("rate_limits")
}

model Profile {
  id        String   @id
  userId    String   @unique
  phone     String?
  district  String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model AuditLog {
  id          String   @id
  actorUserId String?
  actorEmail  String
  action      String
  targetType  String?
  targetId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

model Category {
  id            String     @id
  slug          String     @unique
  nameEn        String
  nameBn        String
  descriptionEn String
  descriptionBn String
  path          String     @unique
  depth         Int        @default(0)
  sortOrder     Int        @default(0)
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[] @relation("CategoryTree")
  products      Product[]

  @@index([parentId])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id             String           @id
  slug           String           @unique
  titleEn        String
  titleBn        String
  descriptionEn  String
  descriptionBn  String
  status         String           @default("active")
  tone           String           @default("accent")
  priceMinor     Int
  compareAtMinor Int?
  totalStock     Int              @default(0)
  rating         Float            @default(0)
  reviewCount    Int              @default(0)
  categoryId     String
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  variants       ProductVariant[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  reviews        Review[]
  questions      ProductQuestion[]

  @@index([categoryId, status])
  @@index([organizationId])
  @@index([status, createdAt])
  @@index([priceMinor])
  @@index([rating])
  @@map("products")
}

model ProductVariant {
  id             String     @id
  productId      String
  sku            String     @unique
  nameEn         String
  nameBn         String
  priceMinor     Int
  compareAtMinor Int?
  stock          Int        @default(0)
  isDefault      Boolean    @default(false)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  product        Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockReservations StockReservation[]
  adjustments    InventoryAdjustment[]

  @@index([productId])
  @@map("product_variants")
}

model Cart {
  id         String     @id
  userId     String?    @unique
  guestToken String?    @unique
  couponCode String?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String         @id
  cartId    String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Coupon {
  id                String        @id
  code              String        @unique
  type              String
  value             Int           @default(0)
  scope             String        @default("global")
  organizationId    String?
  minSubtotalMinor  Int           @default(0)
  maxDiscountMinor  Int?
  startsAt          DateTime?
  endsAt            DateTime?
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  redemptions       CouponRedemption[]

  @@index([organizationId])
  @@index([active, endsAt])
  @@map("coupons")
}

model Address {
  id            String   @id
  userId        String
  label         String
  recipientName String
  phone         String
  division      String
  district      String
  upazila       String
  area          String?
  addressLine   String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([userId, createdAt])
  @@map("addresses")
}

model Order {
  id             String          @id
  number         String          @unique
  userId         String
  status         String          @default("pending_payment")
  // Set after the order is placed; the snapshot above keeps the address readable.
  paymentStatus  String          @default("pending")
  paymentMethod  String
  currency       String          @default("BDT")
  subtotalMinor  Int
  shippingMinor  Int
  discountMinor  Int             @default(0)
  vatMinor       Int             @default(0)
  totalMinor     Int
  couponCode     String?
  shippingName   String
  shippingPhone  String
  shippingDivision String
  shippingDistrict String
  shippingUpazila  String
  shippingArea     String?
  shippingLine     String
  notes          String?
  addressId      String?
  placedAt       DateTime        @default(now())
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  address        Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  subOrders      SubOrder[]
  payments       Payment[]
  reservations   StockReservation[]
  redemption     CouponRedemption?
  mailOutbox     MailOutbox[]
  refunds        Refund[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@map("orders")
}

model SubOrder {
  id             String      @id
  number         String      @unique
  orderId        String
  organizationId String
  status         String      @default("pending")
  subtotalMinor  Int
  shippingMinor  Int         @default(0)
  discountMinor  Int         @default(0)
  totalMinor     Int
  confirmedAt    DateTime?
  packedAt       DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  courier        String?
  trackingNumber String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items          OrderItem[]

  @@index([orderId])
  @@index([organizationId, status])
  @@map("sub_orders")
}

model OrderItem {
  id             String         @id
  orderId        String
  subOrderId     String
  productId      String
  variantId      String
  titleEn        String
  titleBn        String
  variantNameEn  String
  variantNameBn  String
  sku            String
  tone           String         @default("accent")
  unitPriceMinor Int
  quantity       Int
  lineTotalMinor Int
  createdAt      DateTime       @default(now())
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrder       SubOrder       @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  review         Review?
  returnRequest  ReturnRequest?

  @@index([orderId])
  @@index([subOrderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id           String           @id
  orderId      String
  provider     String
  status       String           @default("pending")
  amountMinor  Int
  currency     String           @default("BDT")
  providerRef  String?          @unique
  failureCode  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  paidAt       DateTime?
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts     PaymentAttempt[]

  @@index([orderId, status])
  @@index([provider, status])
  @@map("payments")
}

model PaymentAttempt {
  id          String   @id
  paymentId   String
  provider    String
  status      String
  message     String?
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

model StockReservation {
  id        String   @id
  orderId   String
  variantId String
  quantity  Int
  status    String   @default("held")
  expiresAt DateTime
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([variantId, status])
  @@index([expiresAt, status])
  @@map("stock_reservations")
}

model CouponRedemption {
  id            String   @id
  couponId      String
  couponCode    String
  orderId       String   @unique
  userId        String
  discountMinor Int
  createdAt     DateTime @default(now())
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([couponId])
  @@index([userId, createdAt])
  @@map("coupon_redemptions")
}

model MailOutbox {
  id        String    @id
  userId    String?
  orderId   String?
  toEmail   String
  subject   String
  bodyText  String
  status    String    @default("queued")
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([toEmail, createdAt])
  @@index([userId, createdAt])
  @@map("mail_outbox")
}

model Review {
  id          String        @id
  // Set for buyer reviews written from a delivered order line; seeded demo
  // reviews predate the order and keep it empty so they cannot fake a purchase.
  orderItemId String?       @unique
  productId   String
  userId      String
  rating      Int
  title       String
  body        String
  status      String        @default("published")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orderItem   OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      ReviewPhoto[]

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@map("reviews")
}

model ReviewPhoto {
  id        String @id
  reviewId  String
  // A resized JPEG data URL. Product media has no object-storage host on the
  // free plan yet, so the demo keeps bounded thumbnails with the review row.
  dataUrl   String
  sortOrder Int    @default(0)
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_photos")
}

model ProductQuestion {
  id                String    @id
  productId         String
  userId            String
  body              String
  status            String    @default("open")
  answerBody        String?
  answeredAt        DateTime?
  answeredByUserId  String?
  createdAt         DateTime  @default(now())
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@map("product_questions")
}

model LedgerTransaction {
  id          String        @id
  kind        String
  referenceId String
  memo        String?
  createdAt   DateTime      @default(now())
  entries     LedgerEntry[]

  @@unique([kind, referenceId])
  @@index([createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id
  transactionId String
  accountCode   String
  direction     String
  amountMinor   Int
  createdAt     DateTime          @default(now())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([accountCode, createdAt])
  @@map("ledger_entries")
}

model Payout {
  id              String       @id
  number          String       @unique
  organizationId  String
  amountMinor     Int
  status          String       @default("requested")
  note            String?
  requestedByUserId String
  requestedAt     DateTime     @default(now())
  processedAt     DateTime?
  processedByUserId String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, requestedAt])
  @@index([status, requestedAt])
  @@map("payouts")
}

model Refund {
  id              String         @id
  orderId         String
  returnRequestId String         @unique
  organizationId  String
  amountMinor     Int
  commissionMinor Int
  status          String         @default("paid")
  note            String?
  createdAt       DateTime       @default(now())
  processedAt     DateTime?
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnRequest   ReturnRequest  @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("refunds")
}

model InventoryAdjustment {
  id          String         @id
  variantId   String
  actorUserId String
  delta       Int
  reason      String
  note        String?
  stockAfter  Int
  createdAt   DateTime       @default(now())
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@map("inventory_adjustments")
}

model ReturnRequest {
  id             String    @id
  orderItemId    String    @unique
  userId         String
  reason         String
  note           String?
  status         String    @default("requested")
  resolutionNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refund         Refund?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("return_requests")
}

model WishlistItem {
  id        String   @id
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

model CmsEntry {
  id               String       @id
  // page: static storefront page, help: help article, journal: journal post.
  kind             String
  slug             String
  titleEn          String
  titleBn          String
  excerptEn        String?
  excerptBn        String?
  bodyEn           String
  bodyBn           String
  status           String       @default("draft")
  publishAt        DateTime?
  seoTitleEn       String?
  seoTitleBn       String?
  seoDescriptionEn String?
  seoDescriptionBn String?
  authorUserId     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  versions         CmsVersion[]

  @@unique([kind, slug])
  @@index([kind, status, publishAt])
  @@index([updatedAt])
  @@map("cms_entries")
}

model CmsVersion {
  id           String   @id
  entryId      String
  version      Int
  snapshot     Json
  note         String?
  authorUserId String?
  createdAt    DateTime @default(now())
  entry        CmsEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, version])
  @@index([entryId, version])
  @@map("cms_versions")
}

model FeatureFlag {
  key             String   @id
  labelEn         String
  labelBn         String
  descriptionEn   String?
  descriptionBn   String?
  enabled         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  @@map("feature_flags")
}
